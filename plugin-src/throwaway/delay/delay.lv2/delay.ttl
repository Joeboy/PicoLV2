@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<https://joebutton.co.uk/lv2/delay-poc>
    a lv2:Plugin , lv2:DelayPlugin ;
    doap:name "Simple Delay POC" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "delay_time" ;
        lv2:name "Delay Time" ;
        lv2:default 0.25 ;
        lv2:minimum 0.001 ;
        lv2:maximum 0.5 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.95 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "dry_wet" ;
        lv2:name "Dry/Wet" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] .

@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ingen: <http://drobilla.net/ns/ingen#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<Note>
	ingen:canvasX 246.0 ;
	ingen:canvasY 137.0 ;
	lv2:port <Note/bend> ,
		<Note/frequency> ,
		<Note/gate> ,
		<Note/input> ,
		<Note/number> ,
		<Note/pressure> ,
		<Note/trigger> ,
		<Note/velocity> ;
	lv2:prototype <http://drobilla.net/ns/ingen-internals#Note> ;
	a ingen:Block .

<Note/bend>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:default 0.0 ;
	lv2:index 5 ;
	lv2:maximum 1.0 ;
	lv2:minimum -1.0 ;
	lv2:name "Bender" ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/frequency>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:index 1 ;
	lv2:maximum 25088.0 ;
	lv2:minimum 16.0 ;
	lv2:name "Frequency" ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/gate>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:index 3 ;
	lv2:name "Gate" ;
	lv2:portProperty lv2:toggled ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/input>
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 0 ;
	lv2:name "Input" ;
	a atom:AtomPort ,
		lv2:InputPort .

<Note/number>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:index 1 ;
	lv2:maximum 127.0 ;
	lv2:minimum 0.0 ;
	lv2:name "Number" ;
	lv2:portProperty lv2:integer ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/pressure>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:default 0.0 ;
	lv2:index 6 ;
	lv2:maximum 1.0 ;
	lv2:minimum 0.0 ;
	lv2:name "Pressure" ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/trigger>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:index 4 ;
	lv2:name "Trigger" ;
	lv2:portProperty lv2:toggled ;
	a atom:AtomPort ,
		lv2:OutputPort .

<Note/velocity>
	atom:bufferType atom:Sequence ;
	atom:supports atom:Float ;
	lv2:index 2 ;
	lv2:maximum 1.0 ;
	lv2:minimum 0.0 ;
	lv2:name "Velocity" ;
	a atom:AtomPort ,
		lv2:OutputPort .

<audio_out_1>
	ingen:canvasX 1167.0 ;
	ingen:canvasY 500.0 ;
	lv2:index 3 ;
	lv2:name "Audio Out 1" ;
	lv2:symbol "audio_out_1" ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<control>
	ingen:canvasX 32.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 0 ;
	lv2:name "Control" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "control" ;
	a atom:AtomPort ,
		lv2:InputPort .

<env>
	ingen:canvasX 413.0 ;
	ingen:canvasY 528.0 ;
	lv2:port <env/attack> ,
		<env/decay> ,
		<env/delay> ,
		<env/gate> ,
		<env/hold> ,
		<env/invOut> ,
		<env/out> ,
		<env/release> ,
		<env/retrigger> ,
		<env/sustain> ,
		<env/timeScale> ;
	lv2:prototype <http://github.com/blablack/ams-lv2/env> ;
	a ingen:Block .

<env/attack>
	ingen:value 0.28999999 ;
	lv2:index 2 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/decay>
	ingen:value 0.22 ;
	lv2:index 3 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/delay>
	ingen:value 0.0 ;
	lv2:index 6 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/gate>
	ingen:value 0.0 ;
	lv2:index 0 ;
	lv2:portProperty lv2:toggled ;
	a lv2:CVPort ,
		lv2:InputPort .

<env/hold>
	ingen:value 0.02 ;
	lv2:index 7 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/invOut>
	lv2:index 10 ;
	a lv2:CVPort ,
		lv2:OutputPort .

<env/out>
	lv2:index 9 ;
	a lv2:CVPort ,
		lv2:OutputPort .

<env/release>
	ingen:value 0.05 ;
	lv2:index 5 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/retrigger>
	ingen:value 0.0 ;
	lv2:index 1 ;
	lv2:portProperty lv2:toggled ;
	a lv2:CVPort ,
		lv2:InputPort .

<env/sustain>
	ingen:value 0.69999999 ;
	lv2:index 4 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<env/timeScale>
	ingen:value 2.19000006 ;
	lv2:index 8 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<event_in_1>
	ingen:canvasX 87.0 ;
	ingen:canvasY 117.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 2 ;
	lv2:name "Event In 1" ;
	lv2:symbol "event_in_1" ;
	a atom:AtomPort ,
		lv2:InputPort .

<hztovc>
	ingen:canvasX 418.0 ;
	ingen:canvasY 172.0 ;
	ingen:polyphonic true ;
	lv2:port <hztovc/input> ,
		<hztovc/octaveOffset> ,
		<hztovc/output> ;
	lv2:prototype <http://github.com/blablack/ams-lv2/hztovc> ;
	a ingen:Block .

<hztovc/input>
	ingen:value 440.0 ;
	lv2:index 1 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<hztovc/octaveOffset>
	ingen:value 0.0 ;
	lv2:index 0 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<hztovc/output>
	lv2:index 2 ;
	a lv2:CVPort ,
		lv2:OutputPort .

<>
	ingen:arc [
		ingen:head <vcalin/in1Data> ;
		ingen:tail <vcf/out>
	] , [
		ingen:head <vcf/in> ;
		ingen:tail <vco3/out>
	] , [
		ingen:head <audio_out_1> ;
		ingen:tail <vcalin/out>
	] , [
		ingen:head <vco3/freq> ;
		ingen:tail <hztovc/output>
	] , [
		ingen:head <vcalin/gain1Data> ;
		ingen:tail <env/out>
	] , [
		ingen:head <vcf/freqPort> ;
		ingen:tail <env/out>
	] , [
		ingen:head <env/retrigger> ;
		ingen:tail <Note/trigger>
	] , [
		ingen:head <env/gate> ;
		ingen:tail <Note/gate>
	] , [
		ingen:head <hztovc/input> ;
		ingen:tail <Note/frequency>
	] , [
		ingen:head <Note/input> ;
		ingen:tail <event_in_1>
	] ;
	ingen:block <Note> ,
		<env> ,
		<hztovc> ,
		<vcalin> ,
		<vcf> ,
		<vco3> ;
	ingen:polyphony 1 ;
	<http://lv2plug.in/ns/extensions/ui#ui> ingen:GraphUIGtk2 ;
	lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
	lv2:port <audio_out_1> ,
		<control> ,
		<event_in_1> ,
		<notify> ;
	doap:name "ams_minimalsynth" ;
	a ingen:Graph ,
		lv2:Plugin .


@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ingen: <http://drobilla.net/ns/ingen#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<Piano>
	ingen:canvasX 256.0 ;
	ingen:canvasY 150.0 ;
	ingen:polyphonic true ;
	lv2:port <Piano/env_decay> ,
		<Piano/env_release> ,
		<Piano/event_in> ,
		<Piano/fine_tuning> ,
		<Piano/hardness_offset> ,
		<Piano/left_out> ,
		<Piano/muffling_filter> ,
		<Piano/polyphony> ,
		<Piano/random_detuning> ,
		<Piano/right_out> ,
		<Piano/stereo_width> ,
		<Piano/stretch_tuning> ,
		<Piano/vel_sensitivity> ,
		<Piano/vel_to_hardness> ,
		<Piano/vel_to_muffling> ;
	lv2:prototype <http://moddevices.com/plugins/mda/Piano> ;
	a ingen:Block .

<Piano/env_decay>
	ingen:value 50.0 ;
	lv2:designation <http://lv2plug.in/ns/ext/parameters#decay> ;
	lv2:index 0 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/env_release>
	ingen:value 50.0 ;
	lv2:designation <http://lv2plug.in/ns/ext/parameters#release> ;
	lv2:index 1 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/event_in>
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 14 ;
	a atom:AtomPort ,
		lv2:InputPort .

<Piano/fine_tuning>
	ingen:value 0.0 ;
	lv2:index 9 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/hardness_offset>
	ingen:value 0.0 ;
	lv2:index 2 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/left_out>
	lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	lv2:index 12 ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<Piano/muffling_filter>
	ingen:value 80.30000305 ;
	lv2:index 4 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/polyphony>
	ingen:value 1.0 ;
	lv2:index 8 ;
	lv2:portProperty lv2:enumeration ,
		lv2:integer ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/random_detuning>
	ingen:value 12.30000019 ;
	lv2:index 10 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/right_out>
	lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	lv2:index 13 ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<Piano/stereo_width>
	ingen:value 100.0 ;
	lv2:index 7 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/stretch_tuning>
	ingen:value 0.0 ;
	lv2:index 11 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/vel_sensitivity>
	ingen:value 37.59999847 ;
	lv2:index 6 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/vel_to_hardness>
	ingen:value 50.0 ;
	lv2:index 3 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<Piano/vel_to_muffling>
	ingen:value 25.10000038 ;
	lv2:index 5 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<audio_out_1>
	ingen:canvasX 523.0 ;
	ingen:canvasY 353.0 ;
	lv2:index 3 ;
	lv2:name "Audio Out 1" ;
	lv2:symbol "audio_out_1" ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<control>
	ingen:canvasX 32.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 0 ;
	lv2:name "Control" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "control" ;
	a atom:AtomPort ,
		lv2:InputPort .

<event_in_1>
	ingen:canvasX 85.0 ;
	ingen:canvasY 124.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 2 ;
	lv2:name "Event In 1" ;
	lv2:symbol "event_in_1" ;
	a atom:AtomPort ,
		lv2:InputPort .

<>
	ingen:arc [
		ingen:head <audio_out_1> ;
		ingen:tail <Piano/left_out>
	] , [
		ingen:head <Piano/event_in> ;
		ingen:tail <event_in_1>
	] ;
	ingen:block <Piano> ;
	ingen:polyphony 1 ;
	<http://lv2plug.in/ns/extensions/ui#ui> ingen:GraphUIGtk2 ;
	lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
	lv2:port <audio_out_1> ,
		<control> ,
		<event_in_1> ,
		<notify> ;
	doap:name "mda_epiano" ;
	a ingen:Graph ,
		lv2:Plugin .

<notify>
	ingen:canvasX 128.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 1 ;
	lv2:name "Notify" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "notify" ;
	a atom:AtomPort ,
		lv2:OutputPort .

@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ingen: <http://drobilla.net/ns/ingen#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<EPiano>
	ingen:canvasX 251.0 ;
	ingen:canvasY 155.0 ;
	ingen:polyphonic true ;
	lv2:port <EPiano/env_decay> ,
		<EPiano/env_release> ,
		<EPiano/event_in> ,
		<EPiano/fine_tuning> ,
		<EPiano/hardness> ,
		<EPiano/left_out> ,
		<EPiano/lfo_rate> ,
		<EPiano/modulation> ,
		<EPiano/overdrive> ,
		<EPiano/polyphonic> ,
		<EPiano/random_tuning> ,
		<EPiano/right_out> ,
		<EPiano/stereo_width> ,
		<EPiano/treble_boost> ,
		<EPiano/vel_sense> ;
	lv2:prototype <http://moddevices.com/plugins/mda/EPiano> ;
	a ingen:Block .

<EPiano/env_decay>
	ingen:value 8.5 ;
	lv2:index 0 ;
	lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/env_release>
	ingen:value 0.12 ;
	lv2:index 1 ;
	lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/event_in>
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 14 ;
	a atom:AtomPort ,
		lv2:InputPort .

<EPiano/fine_tuning>
	ingen:value 0.0 ;
	lv2:index 9 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/hardness>
	ingen:value 0.0 ;
	lv2:index 2 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/left_out>
	lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	lv2:index 12 ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<EPiano/lfo_rate>
	ingen:value 4.0 ;
	lv2:index 5 ;
	lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ,
		<http://moddevices.com/ns/mod#tapTempo> ,
		<http://moddevices.com/ns/mod#tempoRelatedDynamicScalePoints> ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/modulation>
	ingen:value 0.0 ;
	lv2:index 4 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/overdrive>
	ingen:value 0.0 ;
	lv2:index 11 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/polyphonic>
	ingen:value 1.0 ;
	lv2:index 8 ;
	lv2:portProperty lv2:integer ,
		lv2:toggled ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/random_tuning>
	ingen:value 7.30000019 ;
	lv2:index 10 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/right_out>
	lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	lv2:index 13 ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<EPiano/stereo_width>
	ingen:value 100.0 ;
	lv2:index 7 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/treble_boost>
	ingen:value 0.0 ;
	lv2:index 3 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<EPiano/vel_sense>
	ingen:value 0.0 ;
	lv2:index 6 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<audio_out_1>
	ingen:canvasX 523.0 ;
	ingen:canvasY 353.0 ;
	lv2:index 3 ;
	lv2:name "Audio Out 1" ;
	lv2:symbol "audio_out_1" ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<control>
	ingen:canvasX 32.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 0 ;
	lv2:name "Control" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "control" ;
	a atom:AtomPort ,
		lv2:InputPort .

<event_in_1>
	ingen:canvasX 85.0 ;
	ingen:canvasY 124.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 2 ;
	lv2:name "Event In 1" ;
	lv2:symbol "event_in_1" ;
	a atom:AtomPort ,
		lv2:InputPort .

<>
	ingen:arc [
		ingen:head <EPiano/event_in> ;
		ingen:tail <event_in_1>
	] , [
		ingen:head <audio_out_1> ;
		ingen:tail <EPiano/left_out>
	] ;
	ingen:block <EPiano> ;
	ingen:polyphony 1 ;
	<http://lv2plug.in/ns/extensions/ui#ui> ingen:GraphUIGtk2 ;
	lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
	lv2:port <audio_out_1> ,
		<control> ,
		<event_in_1> ,
		<notify> ;
	doap:name "mda_epiano" ;
	a ingen:Graph ,
		lv2:Plugin .

<notify>
	ingen:canvasX 128.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 1 ;
	lv2:name "Notify" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "notify" ;
	a atom:AtomPort ,
		lv2:OutputPort .

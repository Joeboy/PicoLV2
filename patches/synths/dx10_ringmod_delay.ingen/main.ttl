		lv2:InputPort .

<>
	ingen:arc [
		ingen:head <audio_out_1> ;
		ingen:tail <delay_poc/out>
	] , [
		ingen:head <delay_poc/in> ;
		ingen:tail <RingMod/left_out>
	] , [
		ingen:head <RingMod/left_in> ;
		ingen:tail <DX10/left_out>
	] , [
		ingen:head <DX10/event_in> ;
		ingen:tail <event_in_1>
	] ;
	ingen:block <DX10> ,
		<RingMod> ,
		<delay_poc> ;
	ingen:polyphony 1 ;
	<http://lv2plug.in/ns/extensions/ui#ui> ingen:GraphUIGtk2 ;
	lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
	lv2:port <audio_out_1> ,
		<control> ,
		<event_in_1> ,
		<notify> ;
	doap:name "mda_dx10" ;
	a ingen:Graph ,
		lv2:Plugin .


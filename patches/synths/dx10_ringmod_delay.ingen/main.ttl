<delay_poc>
	ingen:canvasX 602.0 ;
	ingen:canvasY 387.0 ;
	lv2:port <delay_poc/delay_time> ,
		<delay_poc/dry_wet> ,
		<delay_poc/feedback> ,
		<delay_poc/in> ,
		<delay_poc/out> ;
	lv2:prototype <https://joebutton.co.uk/lv2/delay-poc> ;

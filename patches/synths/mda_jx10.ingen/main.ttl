@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<JX10>
	ingen:canvasX 290.0 ;
	ingen:canvasY 23.0 ;
	ingen:polyphonic true ;
	lv2:port <JX10/env_att> ,
		<JX10/env_dec> ,
		<JX10/env_rel> ,
		<JX10/env_sus> ,
		<JX10/event_in> ,
		<JX10/gld_bend> ,
		<JX10/gld_rate> ,
		<JX10/glide> ,
		<JX10/left_out> ,
		<JX10/lfo_rate> ,
		<JX10/noise> ,
		<JX10/octave> ,
		<JX10/osc_fine> ,
		<JX10/osc_mix> ,
		<JX10/osc_tune> ,
		<JX10/right_out> ,
		<JX10/tuning> ,
		<JX10/vcf_att> ,
		<JX10/vcf_dec> ,
		<JX10/vcf_env> ,
		<JX10/vcf_freq> ,
		<JX10/vcf_lfo> ,
		<JX10/vcf_rel> ,
		<JX10/vcf_reso> ,
		<JX10/vcf_sus> ,
		<JX10/vcf_vel> ,
		<JX10/vibrato> ;
	lv2:prototype <http://moddevices.com/plugins/mda/JX10> ;
	a ingen:Block .

<JX10/env_att>
	ingen:value 0.0 ;
	lv2:designation <http://lv2plug.in/ns/ext/parameters#attack> ;
	lv2:index 15 ;
	a lv2:ControlPort ,
		lv2:InputPort .

<JX10/env_dec>

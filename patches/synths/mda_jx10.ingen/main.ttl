<audio_out_1>
	ingen:canvasX 493.0 ;
	ingen:canvasY 610.0 ;
	lv2:index 3 ;
	lv2:name "Audio Out 1" ;
	lv2:symbol "audio_out_1" ;
	a lv2:AudioPort ,
		lv2:OutputPort .

<control>
	ingen:canvasX 32.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 0 ;
	lv2:name "Control" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "control" ;
	a atom:AtomPort ,
		lv2:InputPort .

<event_in_1>
	ingen:canvasX 81.0 ;
	ingen:canvasY 586.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports midi:MidiEvent ;
	lv2:index 2 ;
	lv2:name "Event In 1" ;
	lv2:symbol "event_in_1" ;
	a atom:AtomPort ,
		lv2:InputPort .

<>
	ingen:arc [
		ingen:head <audio_out_1> ;
		ingen:tail <JX10/left_out>
	] , [
		ingen:head <JX10/event_in> ;
		ingen:tail <event_in_1>
	] ;
	ingen:block <JX10> ;
	ingen:polyphony 1 ;
	<http://lv2plug.in/ns/extensions/ui#ui> ingen:GraphUIGtk2 ;
	lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
	lv2:port <audio_out_1> ,
		<control> ,
		<event_in_1> ,
		<notify> ;
	doap:name "mda_jx10" ;
	a ingen:Graph ,
		lv2:Plugin .

<notify>
	ingen:canvasX 128.0 ;
	ingen:canvasY 32.0 ;
	atom:bufferType atom:Sequence ;
	atom:supports patch:Message ;
	<http://lv2plug.in/ns/ext/resize-port#minimumSize> 4096 ;
	lv2:designation lv2:control ;
	lv2:index 1 ;
	lv2:name "Notify" ;
	lv2:portProperty lv2:connectionOptional ;
	lv2:symbol "notify" ;
	a atom:AtomPort ,
		lv2:OutputPort .
